# Database MySQL (lokal via docker compose service "db")
DATABASE_URL="mysql://cks:cks_secret@127.0.0.1:3306/cks_web"

# Di dalam container web, host db: mysql://cks:cks_secret@db:3306/cks_web

# Secret untuk sesi login admin (ganti dengan string acak panjang)
SESSION_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"

# Kredensial awal saat seed (hanya dipakai jika user belum ada)
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@cks.id"
ADMIN_PASSWORD="admin123"

AUTHOR_NAME="Redaksi"
AUTHOR_EMAIL="redaksi@cks.id"
AUTHOR_PASSWORD="redaksi123"

# Folder penyimpanan upload (default: ./uploads, disajikan via /media/...)
UPLOAD_DIR="./uploads"
